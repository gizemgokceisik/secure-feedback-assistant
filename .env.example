# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Azure AI Language (sentiment analysis) ---
AZURE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com/language/:analyze-text?api-version=2023-04-01
AZURE_API_KEY=<your-language-key>
AZURE_REGION=westeurope

# --- Azure OpenAI (chat) ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_KEY=<your-openai-key>
AZURE_OPENAI_DEPLOYMENT=chat-small          # deployment name, not the model name
AZURE_OPENAI_API_VERSION=2024-06-01

# --- App ---
PORT=3000
